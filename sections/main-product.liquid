<div>
  <div class="container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'title' -%}
          <div {{ block.shopify_attributes }}>
            <h1>{{ product.title }}</h1>
          </div>
        {%- when 'add_to_cart' -%}
          {% form 'product', product %}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
            >
            <input type="text" name="quantity" min="1" value="1">
            <button type="submit">Add to Cart</button>
          {% endform %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "add_to_cart",
      "name": "Add to Cart",
      "limit": 1
    }
  ]
}
{% endschema %}
